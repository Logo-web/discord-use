# Discord user token (account token, NOT a bot token).
# DevTools > Application > Local Storage > discord.com > token — copy, keep secret.
# NEVER commit the real token. This file stays as example only.
DISCORD_TOKEN=

# Vercel AI Gateway key — Jev is called through
# https://ai-gateway.vercel.sh/typesafe using THIS key.
AI_GATEWAY_API_KEY=
# Back-compat: a TYPESAFE_API_KEY holding the gateway key also works.
# TYPESAFE_API_KEY=
